# Copy this file to .env.local and fill it in. .env.local is never committed.

# Password for the order admin page at /admin/orders (pick a long random string)
ADMIN_KEY=change-me-to-something-long

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Order storage (Supabase). Required on Vercel. Leave both unset locally to save orders to data/orders.json.
# Supabase dashboard > Project Settings > API: the project URL and the service_role (or sb_secret_...) key.
# Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
